# Copy to `.env` at the repo root. The web app and the worker both read it.
# On Vercel and GitHub Actions, set these as environment variables / secrets instead.

# --- Database (Supabase Postgres; copy from Dashboard -> Connect) ---
# Transaction pooler (port 6543). Used by the web app and worker at runtime.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>.pooler.supabase.com:6543/postgres
# Session pooler (port 5432). Used only by `pnpm db:migrate`.
DATABASE_MIGRATION_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>.pooler.supabase.com:5432/postgres
# Connections per server instance. Keep small on the free tier.
DATABASE_POOL_MAX=3

# --- Supabase Auth (Dashboard -> Project Settings -> API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# The publishable key (sb_publishable_...). The legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- App ---
# Public base URL; must be listed in Supabase Auth -> URL Configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
LOG_LEVEL=info

# --- M1: private résumé storage and background extraction ---
# Manual profile entry works without these. Turn uploads on only after storage and the worker are configured.
RESUME_UPLOADS_ENABLED=false
RESUME_STORAGE_BUCKET=resumes
# Server/worker only. Never use a NEXT_PUBLIC_ prefix for this secret.
# SUPABASE_SECRET_KEY=sb_secret_...
# --- LLM (worker for résumés; web app and worker for jobs from M3) ---
# Optional for jobs: without a key, postings are read by keyword with structured explanations.
# A paid/no-training provider tier is required before using real personal data.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=
# Alternative: LLM_PROVIDER=openai, LLM_MODEL=<your-model>, OPENAI_API_KEY=<your-key>
# OPENAI_API_KEY=
# Defaults to gemini-embedding-001 (Gemini) or text-embedding-3-small (OpenAI), at 768 dimensions.
# LLM_EMBEDDING_MODEL=
# Set to your provider's actual quotas. These are conservative app limits, not a provider plan guarantee.
LLM_RPM=5
LLM_DAILY_REQUESTS=100

# --- M4: job collection ---
# Comma-separated sign-in emails allowed on /admin. Empty means nobody.
ADMIN_EMAILS=
# Optional. From developer.adzuna.com; without them `pnpm worker ingest` skips Adzuna. Set both or neither.
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
