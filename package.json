{
  "name": "fitwise",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@repo/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @repo/web test:e2e",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "pnpm --filter @repo/db generate",
    "db:migrate": "pnpm --filter @repo/db migrate",
    "worker": "pnpm --filter @repo/worker start"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.20.5",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
